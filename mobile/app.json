{
  "expo": {
    "name": "SHOW YOUR HAND",
    "slug": "show-your-hand-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "showyourhand",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": [
      "expo-router"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bthedream.showyourhand",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.bthedream.showyourhand",
      "versionCode": 1
    },
    "experiments": {
      "typedRoutes": true
    },
    "owner": "bferrell514",
    "platforms": [
      "ios",
      "android"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    }
  }
}
